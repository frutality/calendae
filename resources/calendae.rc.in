#include <winver.h>

IDI_ICON1 ICON "calendae.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Alexander Yaskevich"
            VALUE "FileDescription", "Calendae"
            VALUE "FileVersion", "@CALENDAE_VERSION_STRING@"
            VALUE "InternalName", "calendae"
            VALUE "LegalCopyright", "Copyright (C) 2026 Alexander Yaskevich"
            VALUE "OriginalFilename", "calendae.exe"
            VALUE "ProductName", "Calendae"
            VALUE "ProductVersion", "@CALENDAE_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
